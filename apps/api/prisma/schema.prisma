generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  user
  operator
  admin
}

enum UserStatus {
  active
  suspended
  deleted
}

enum ConnectorType {
  Type1
  Type2
  CCS
  CHAdeMO
  Tesla
}

enum StationStatus {
  active
  maintenance
  offline
  coming_soon
}

enum ApprovalStatus {
  pending
  approved
  rejected
}

enum ChargerStatus {
  available
  in_use
  reserved
  faulted
  unavailable
}

enum ChargingSpeed {
  slow
  fast
  rapid
  ultra_rapid
}

enum BookingStatus {
  pending
  confirmed
  active
  completed
  cancelled
  no_show
}

enum SessionStatus {
  initiated
  charging
  paused
  completed
  failed
}

enum PaymentMethod {
  card
  upi
  wallet
  net_banking
}

enum PaymentStatus {
  pending
  processing
  completed
  failed
  refunded
}

enum TransactionType {
  credit
  debit
  refund
}

enum NotificationType {
  booking_confirmed
  charging_started
  charging_completed
  payment_success
  payment_failed
  station_available
  maintenance_alert
  promotional
}

model User {
  id                  String               @id @default(uuid())
  email               String               @unique
  passwordHash        String               @map("password_hash")
  fullName            String               @map("full_name")
  phone               String?
  role                UserRole             @default(user)
  status              UserStatus           @default(active)
  emailVerified       Boolean              @default(false) @map("email_verified")
  profileImageUrl     String?              @map("profile_image_url")
  createdAt           DateTime             @default(now()) @map("created_at")
  updatedAt           DateTime             @updatedAt @map("updated_at")
  lastLoginAt         DateTime?            @map("last_login_at")
  vehicles            UserVehicle[]
  bookings            Booking[]
  chargingSessions    ChargingSession[]
  payments            Payment[]
  wallet              Wallet?
  reviews             Review[]
  favorites           Favorite[]
  notifications       Notification[]
  refreshTokens       RefreshToken[]
  passwordResetTokens PasswordResetToken[]
  operatedStations    ChargingStation[]    @relation("StationOperator")

  @@map("users")
}

model RefreshToken {
  id           String    @id @default(uuid())
  userId       String    @map("user_id")
  tokenHash    String    @unique @map("token_hash")
  familyId     String    @map("family_id")
  replacedById String?   @map("replaced_by_id")
  revokedAt    DateTime? @map("revoked_at")
  expiresAt    DateTime  @map("expires_at")
  createdAt    DateTime  @default(now()) @map("created_at")
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([familyId])
  @@map("refresh_tokens")
}

model PasswordResetToken {
  id        String    @id @default(uuid())
  userId    String    @map("user_id")
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_reset_tokens")
}

model UserVehicle {
  id                 String            @id @default(uuid())
  userId             String            @map("user_id")
  make               String
  model              String
  year               Int?
  batteryCapacityKwh Decimal?          @map("battery_capacity_kwh") @db.Decimal(5, 2)
  connectorType      ConnectorType     @map("connector_type")
  isPrimary          Boolean           @default(false) @map("is_primary")
  createdAt          DateTime          @default(now()) @map("created_at")
  updatedAt          DateTime          @updatedAt @map("updated_at")
  user               User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  bookings           Booking[]
  chargingSessions   ChargingSession[]

  @@index([userId])
  @@map("user_vehicles")
}

model ChargingStation {
  id                String             @id @default(uuid())
  operatorId        String?            @map("operator_id")
  externalProvider  String?            @map("external_provider")
  externalId        String?            @map("external_id")
  name              String
  description       String?
  address           String
  city              String
  state             String?
  postalCode        String?            @map("postal_code")
  country           String             @default("India")
  latitude          Decimal            @db.Decimal(10, 8)
  longitude         Decimal            @db.Decimal(11, 8)
  status            StationStatus      @default(active)
  approvalStatus    ApprovalStatus     @default(approved) @map("approval_status")
  approvedAt        DateTime?          @map("approved_at")
  amenities         Json               @default("[]")
  images            Json               @default("[]")
  openingTime       DateTime?          @map("opening_time") @db.Time()
  closingTime       DateTime?          @map("closing_time") @db.Time()
  is24x7            Boolean            @default(false) @map("is_24x7")
  basePricePerKwh   Decimal            @map("base_price_per_kwh") @db.Decimal(6, 2)
  rating            Decimal            @default(0) @db.Decimal(3, 2)
  totalReviews      Int                @default(0) @map("total_reviews")
  createdAt         DateTime           @default(now()) @map("created_at")
  updatedAt         DateTime           @updatedAt @map("updated_at")
  operator          User?              @relation("StationOperator", fields: [operatorId], references: [id], onDelete: SetNull)
  chargers          Charger[]
  bookings          Booking[]
  reviews           Review[]
  favorites         Favorite[]
  pricingRules      PricingRule[]
  demandPredictions DemandPrediction[]

  @@unique([externalProvider, externalId])
  @@index([latitude, longitude])
  @@index([operatorId])
  @@index([status])
  @@map("charging_stations")
}

model Charger {
  id                String            @id @default(uuid())
  stationId         String            @map("station_id")
  chargerIdentifier String            @map("charger_identifier")
  connectorType     ConnectorType     @map("connector_type")
  maxPowerKw        Decimal           @map("max_power_kw") @db.Decimal(5, 2)
  chargingSpeed     ChargingSpeed     @map("charging_speed")
  status            ChargerStatus     @default(available)
  currentSessionId  String?           @map("current_session_id")
  lastMaintenanceAt DateTime?         @map("last_maintenance_at")
  faultDescription  String?           @map("fault_description")
  createdAt         DateTime          @default(now()) @map("created_at")
  updatedAt         DateTime          @updatedAt @map("updated_at")
  station           ChargingStation   @relation(fields: [stationId], references: [id], onDelete: Cascade)
  bookings          Booking[]
  chargingSessions  ChargingSession[]

  @@unique([stationId, chargerIdentifier])
  @@index([stationId])
  @@index([status])
  @@map("chargers")
}

model Booking {
  id                 String            @id @default(uuid())
  userId             String            @map("user_id")
  stationId          String            @map("station_id")
  chargerId          String?           @map("charger_id")
  vehicleId          String?           @map("vehicle_id")
  status             BookingStatus     @default(pending)
  bookingTime        DateTime          @map("booking_time")
  startTime          DateTime          @map("start_time")
  endTime            DateTime          @map("end_time")
  estimatedKwh       Decimal?          @map("estimated_kwh") @db.Decimal(6, 2)
  priceEstimate      Decimal?          @map("price_estimate") @db.Decimal(8, 2)
  cancellationReason String?           @map("cancellation_reason")
  createdAt          DateTime          @default(now()) @map("created_at")
  updatedAt          DateTime          @updatedAt @map("updated_at")
  user               User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  station            ChargingStation   @relation(fields: [stationId], references: [id], onDelete: Cascade)
  charger            Charger?          @relation(fields: [chargerId], references: [id], onDelete: SetNull)
  vehicle            UserVehicle?      @relation(fields: [vehicleId], references: [id], onDelete: SetNull)
  chargingSessions   ChargingSession[]

  @@index([userId])
  @@index([stationId])
  @@index([chargerId])
  @@index([startTime, endTime])
  @@map("bookings")
}

model ChargingSession {
  id                  String        @id @default(uuid())
  bookingId           String?       @map("booking_id")
  userId              String        @map("user_id")
  chargerId           String?       @map("charger_id")
  vehicleId           String?       @map("vehicle_id")
  status              SessionStatus @default(initiated)
  startTime           DateTime      @map("start_time")
  endTime             DateTime?     @map("end_time")
  energyDeliveredKwh  Decimal       @default(0) @map("energy_delivered_kwh") @db.Decimal(8, 3)
  startBatteryPercent Int?          @map("start_battery_percent")
  endBatteryPercent   Int?          @map("end_battery_percent")
  averagePowerKw      Decimal?      @map("average_power_kw") @db.Decimal(5, 2)
  totalCost           Decimal?      @map("total_cost") @db.Decimal(8, 2)
  paymentStatus       String?       @map("payment_status")
  sessionData         Json?         @map("session_data")
  createdAt           DateTime      @default(now()) @map("created_at")
  updatedAt           DateTime      @updatedAt @map("updated_at")
  booking             Booking?      @relation(fields: [bookingId], references: [id], onDelete: SetNull)
  user                User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  charger             Charger?      @relation(fields: [chargerId], references: [id], onDelete: SetNull)
  vehicle             UserVehicle?  @relation(fields: [vehicleId], references: [id], onDelete: SetNull)
  payments            Payment[]
  reviews             Review[]
  sessionLogs         SessionLog[]

  @@index([userId])
  @@index([chargerId])
  @@index([bookingId])
  @@index([startTime, endTime])
  @@index([status])
  @@map("charging_sessions")
}

model Payment {
  id                   String           @id @default(uuid())
  userId               String           @map("user_id")
  sessionId            String?          @map("session_id")
  amount               Decimal          @db.Decimal(10, 2)
  currency             String           @default("INR")
  paymentMethod        PaymentMethod    @map("payment_method")
  status               PaymentStatus    @default(pending)
  gateway              String?
  gatewayTransactionId String?          @unique @map("gateway_transaction_id")
  gatewayResponse      Json?            @map("gateway_response")
  refundAmount         Decimal          @default(0) @map("refund_amount") @db.Decimal(10, 2)
  createdAt            DateTime         @default(now()) @map("created_at")
  updatedAt            DateTime         @updatedAt @map("updated_at")
  user                 User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  session              ChargingSession? @relation(fields: [sessionId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([sessionId])
  @@index([status])
  @@map("payments")
}

model Wallet {
  id           String              @id @default(uuid())
  userId       String              @unique @map("user_id")
  balance      Decimal             @default(0) @db.Decimal(10, 2)
  createdAt    DateTime            @default(now()) @map("created_at")
  updatedAt    DateTime            @updatedAt @map("updated_at")
  user         User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions WalletTransaction[]

  @@map("wallets")
}

model WalletTransaction {
  id           String          @id @default(uuid())
  walletId     String          @map("wallet_id")
  type         TransactionType
  amount       Decimal         @db.Decimal(10, 2)
  balanceAfter Decimal         @map("balance_after") @db.Decimal(10, 2)
  description  String?
  referenceId  String?         @unique @map("reference_id")
  createdAt    DateTime        @default(now()) @map("created_at")
  wallet       Wallet          @relation(fields: [walletId], references: [id], onDelete: Cascade)

  @@index([walletId])
  @@map("wallet_transactions")
}

model Review {
  id        String           @id @default(uuid())
  userId    String           @map("user_id")
  stationId String           @map("station_id")
  sessionId String?          @map("session_id")
  rating    Int
  comment   String?
  createdAt DateTime         @default(now()) @map("created_at")
  updatedAt DateTime         @updatedAt @map("updated_at")
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  station   ChargingStation  @relation(fields: [stationId], references: [id], onDelete: Cascade)
  session   ChargingSession? @relation(fields: [sessionId], references: [id], onDelete: SetNull)

  @@unique([userId, sessionId])
  @@index([stationId])
  @@index([userId])
  @@map("reviews")
}

model Favorite {
  id        String          @id @default(uuid())
  userId    String          @map("user_id")
  stationId String          @map("station_id")
  createdAt DateTime        @default(now()) @map("created_at")
  user      User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  station   ChargingStation @relation(fields: [stationId], references: [id], onDelete: Cascade)

  @@unique([userId, stationId])
  @@index([userId])
  @@map("favorites")
}

model Notification {
  id        String           @id @default(uuid())
  userId    String           @map("user_id")
  type      NotificationType
  title     String
  message   String
  isRead    Boolean          @default(false) @map("is_read")
  metadata  Json?
  createdAt DateTime         @default(now()) @map("created_at")
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([isRead])
  @@map("notifications")
}

model PricingRule {
  id              String          @id @default(uuid())
  stationId       String          @map("station_id")
  name            String
  startTime       DateTime        @db.Time()
  endTime         DateTime        @db.Time()
  daysOfWeek      Int[]           @default([0, 1, 2, 3, 4, 5, 6]) @map("days_of_week")
  priceMultiplier Decimal         @default(1.0) @map("price_multiplier") @db.Decimal(4, 2)
  isActive        Boolean         @default(true) @map("is_active")
  createdAt       DateTime        @default(now()) @map("created_at")
  updatedAt       DateTime        @updatedAt @map("updated_at")
  station         ChargingStation @relation(fields: [stationId], references: [id], onDelete: Cascade)

  @@index([stationId])
  @@map("pricing_rules")
}

model SessionLog {
  id             String          @id @default(uuid())
  sessionId      String          @map("session_id")
  timestamp      DateTime
  powerKw        Decimal?        @map("power_kw") @db.Decimal(5, 2)
  voltage        Decimal?        @db.Decimal(5, 2)
  current        Decimal?        @db.Decimal(5, 2)
  batteryPercent Int?            @map("battery_percent")
  temperature    Decimal?        @db.Decimal(4, 2)
  createdAt      DateTime        @default(now()) @map("created_at")
  session        ChargingSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
  @@index([timestamp])
  @@map("session_logs")
}

model DemandPrediction {
  id              String          @id @default(uuid())
  stationId       String          @map("station_id")
  predictionDate  DateTime        @map("prediction_date") @db.Date
  hour            Int
  predictedDemand Decimal         @map("predicted_demand") @db.Decimal(5, 2)
  confidenceScore Decimal         @map("confidence_score") @db.Decimal(3, 2)
  createdAt       DateTime        @default(now()) @map("created_at")
  station         ChargingStation @relation(fields: [stationId], references: [id], onDelete: Cascade)

  @@unique([stationId, predictionDate, hour])
  @@map("demand_predictions")
}
